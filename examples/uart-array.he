import extension std::uart::UartText;
device debug = UART0 { baud: 38400, mode: TX, }

fn fill(data: &mut [u8; 4]) {
    var i: u16 = 0;
    while i < data.len() {
        data[i] = 65;
        i = i + 1;
    }
}

fn print_bytes(device out: UartTx, label: &str, data: &[u8; 4]) {
    out.print(label);
    var i: u16 = 0;
    while i < data.len() {
        out.write_byte(data[i]);
        i = i + 1;
    }
    out.newline();
}

setup {
    var buffer: [u8; 4] = [0; 4];
    fill(&mut buffer);
    buffer[1] = 66;
    buffer[2] = 67;
    buffer[3] = 68;
    print_bytes(debug, "SRAM: ", &buffer);
    debug.flush();
}
loop {}
