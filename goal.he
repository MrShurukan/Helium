// Comments
/*
    Multiline comments
    /* Nested too */
*/

// Port declaration
def Button = PortB.2 INPUT;

// Large def declaration
def {
    Button = PortB.2 INPUT_PULLUP;
    Led = PortC.3 OUTPUT;
}

// Setup block (do once block)
setup {
    // Loop
    for i = 1 to 10 {
        Led = HIGH;
        delay 100ms;
        Led = LOW;
        delay 100ms;
    }
}

// Loop block (do infinitely)
loop {
    var test: i32 = 25;
    // No parenthesis if
    if Button == LOW {
        Led = HIGH;
    }
    else {
        Led = LOW;
    }
}