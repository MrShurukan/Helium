// Simple LED + Button example

def {
    Button = PortD.2 INPUT;
    Led    = PortC.5 OUTPUT;
}

setup {
    Led = Led = LOW;
}

loop {
    // Button is pressed when it's connected to GND
    if Button == LOW {
        Led = HIGH;
    }
    else {
        Led = LOW;
    }
}

