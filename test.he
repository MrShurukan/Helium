// Simple LED + Button example

def {
    Button = PortD.2 INPUT;
    Led    = PortC.5 OUTPUT;
}

setup {
    var a = 123;
    var b = 123.0;
    var c = a + b;

    var uns: u16 = 123;
    var sin: i64 = uns + 123;

    Led = LOW;
}

loop {
    // Button is pressed when it's connected to GND
    if Button == LOW {
        Led = HIGH;
    }
    else {
        Led = LOW;
    }
}